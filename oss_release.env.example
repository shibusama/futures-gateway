# 复制为 oss_release.env 并填写（勿提交 oss_release.env）
# 阿里云控制台 → RAM → 用户 → 创建 AccessKey（建议子账号，仅 OSS 权限）

OSS_ACCESS_KEY_ID=你的AccessKeyId
OSS_ACCESS_KEY_SECRET=你的AccessKeySecret

# Bucket 所在地域 endpoint，如 oss-cn-hangzhou.aliyuncs.com
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# Bucket 名称（全局唯一，小写字母数字短横线）
OSS_BUCKET=你的bucket名

# OSS 内目录前缀，不要首尾斜杠
OSS_PREFIX=futures-gateway/releases

# manifest 在 Bucket 内的路径（可与 zip 同前缀）
OSS_MANIFEST_KEY=futures-gateway/update_manifest.json

# 公开访问根 URL（Bucket 详情 → 访问域名 → 外网 Endpoint）
# 示例：https://my-bucket.oss-cn-hangzhou.aliyuncs.com
OSS_PUBLIC_BASE=https://你的bucket.oss-cn-hangzhou.aliyuncs.com
